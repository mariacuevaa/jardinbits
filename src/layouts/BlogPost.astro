---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import AvisoAfiliado from '../components/AvisoAfiliado.astro';
import EtiquetaMadurez from '../components/EtiquetaMadurez.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SelloRevision from '../components/SelloRevision.astro';
import { CATEGORIAS, SITE_TITLE } from '../consts';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & { minutos?: number };

const { title, description, category, madurez, pubDate, revisado, afiliado, heroImage, minutos } = Astro.props;

const datosEstructurados = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	inLanguage: 'es',
	datePublished: pubDate.toISOString().slice(0, 10),
	dateModified: revisado.toISOString().slice(0, 10),
	author: { '@type': 'Person', name: 'María' },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: 'https://jardinbits.com' },
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Base title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
	<article class="contenedor articulo">
		<header class="cabecera-articulo">
			<p class="categoria">
				<a href={`/blog/categoria/${category}/`}>{CATEGORIAS[category].nombre}</a>
			</p>
			<h1>{title}</h1>
			<p class="descripcion">{description}</p>
			<div class="meta">
				<EtiquetaMadurez madurez={madurez} />
				<SelloRevision fecha={revisado} />
				<span class="publicado">
					Publicado el <FormattedDate date={pubDate} />{minutos && ` · ${minutos} min de lectura`}
				</span>
			</div>
		</header>
		{heroImage && <Image class="hero-img" width={1020} height={510} src={heroImage} alt="" />}
		<div class="lectura">
			{afiliado && <AvisoAfiliado />}
			<slot />
			<AdSlot />
		</div>
	</article>
</Base>

<style>
	.articulo {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
	}
	.cabecera-articulo {
		max-width: var(--ancho-lectura);
		margin-bottom: 2.5rem;
	}
	.categoria {
		margin-bottom: 0.6rem;
		font-weight: 600;
	}
	.descripcion {
		font-size: 1.25rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
		margin-top: 1.4rem;
	}
	.publicado {
		font-size: 0.9rem;
	}
	.hero-img {
		display: block;
		margin-bottom: 2.5rem;
		border: 2px solid var(--verde-bosque);
		border-radius: 2px;
	}
</style>
