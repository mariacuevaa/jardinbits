---
import { BLOG_ABIERTO, SITE_TAGLINE, SITE_TITLE } from '../consts';
import Brote from './Brote.astro';
const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="suelo" aria-hidden="true"></div>
	<div class="contenedor interior">
		<div class="presentacion">
			<p class="nombre">
				<Brote class="pie-brote" />
				{SITE_TITLE}
			</p>
			<p>{SITE_TAGLINE}</p>
			<p class="redes">Me encuentras como <strong>@jardinbits</strong> en redes.</p>
		</div>
		<nav aria-label="Pie de página">
			<ul>
				<li><a href="/sobre-mi/">Sobre mí</a></li>
				{BLOG_ABIERTO && <li><a href="/blog/">Blog</a></li>}
				<li><a href="/herramientas-que-uso/">Herramientas que uso</a></li>
				<li><a href="/contacto/">Contacto</a></li>
				<li><a href="/aviso-de-afiliacion/">Aviso de afiliación</a></li>
				<li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
			</ul>
		</nav>
	</div>
	<div class="contenedor legal">
		<p>
			© {anio} {SITE_TITLE}. Si un enlace me da comisión, te lo digo en esa misma página.
		</p>
	</div>
</footer>

<style>
	.pie {
		margin-top: 5rem;
		background: var(--verde-bosque);
		color: var(--crema);
	}
	.pie a {
		color: var(--crema);
		text-decoration-color: var(--lila);
	}
	.pie a:hover {
		background: color-mix(in srgb, var(--lila) 30%, transparent);
	}
	.pie :focus-visible {
		outline-color: var(--crema);
	}
	/* Borde superior en cuadrícula de píxeles, como la tierra del logo */
	.suelo {
		height: 16px;
		background:
			conic-gradient(var(--salvia) 25%, var(--verde-bosque) 0 50%, var(--salvia) 0 75%, var(--verde-bosque) 0) 0 0 / 32px 32px;
		margin-top: -16px;
	}
	.interior {
		display: grid;
		gap: 2rem 4rem;
		padding-block: 3rem 2rem;
	}
	@media (min-width: 46rem) {
		.interior {
			grid-template-columns: 1.4fr 1fr;
		}
	}
	.presentacion p {
		margin: 0 0 0.4rem;
	}
	.nombre {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-family: var(--fuente-titulos);
		font-size: 1.6rem;
		font-weight: 600;
		line-height: 1.1;
	}
	.nombre :global(.pie-brote) {
		width: 2.2rem;
		height: auto;
		padding: 0.25rem;
		background: var(--crema);
		border-radius: 2px;
	}
	.redes {
		margin-top: 1rem !important;
	}
	ul {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.legal {
		padding-block: 1.2rem 2rem;
		border-top: 1px solid color-mix(in srgb, var(--crema) 30%, transparent);
		font-size: 0.9rem;
	}
	.legal p {
		margin: 0;
	}
</style>
