---
import '../styles/global.css';
import { BLOG_ABIERTO, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/og-default.png', noindex = false } = Astro.props;
const imagenURL = new URL(image, Astro.site);
const tituloCompleto = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#2F5D50" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="sitemap" href="/sitemap-index.xml" />
{BLOG_ABIERTO && <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />}
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalURL} />

<title>{tituloCompleto}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imagenURL} />

<meta name="twitter:card" content="summary_large_image" />
