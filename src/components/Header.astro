---
import { BLOG_ABIERTO, SITE_TITLE } from '../consts';
import Brote from './Brote.astro';

const enlaces = [
	{ href: '/', texto: 'Inicio' },
	{ href: '/sobre-mi/', texto: 'Sobre mí' },
	...(BLOG_ABIERTO ? [{ href: '/blog/', texto: 'Blog' }] : []),
	{ href: '/contacto/', texto: 'Contacto' },
];
const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<header class="cabecera">
	<div class="contenedor barra">
		<a class="marca" href="/" aria-label={`${SITE_TITLE}, inicio`}>
			<Brote class="marca-brote" />
			<span class="marca-nombre">{SITE_TITLE}</span>
		</a>
		<nav aria-label="Principal">
			<ul>
				{
					enlaces.map((e) => (
						<li>
							<a href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
								{e.texto}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.cabecera {
		border-bottom: 2px solid var(--verde-bosque);
		background: var(--crema);
	}
	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		padding-block: 0.7rem;
	}
	.marca {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
	}
	.marca:hover {
		background: none;
	}
	.marca :global(.marca-brote) {
		width: 2.1rem;
		height: auto;
	}
	.marca-nombre {
		font-family: var(--fuente-titulos);
		font-size: 1.45rem;
		font-weight: 650;
		letter-spacing: -0.015em;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		display: inline-block;
		padding: 0.5rem 0;
		font-weight: 500;
		text-decoration: none;
		border-bottom: 3px solid transparent;
	}
	nav a:hover {
		background: none;
		border-bottom-color: var(--lila);
	}
	nav a[aria-current='page'] {
		border-bottom-color: var(--verde-bosque);
		font-weight: 650;
	}
</style>
