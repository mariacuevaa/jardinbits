---
import EtiquetaMadurez from '../../components/EtiquetaMadurez.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { BLOG_ABIERTO, CATEGORIAS, type CategoriaId } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPublicados } from '../../lib/posts';

const posts = (await getPublicados()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const grupos = (Object.keys(CATEGORIAS) as CategoriaId[])
	.map((id) => ({ id, ...CATEGORIAS[id], posts: posts.filter((p) => p.data.category === id) }))
	.filter((g) => g.posts.length > 0);
---

<Base
	title="Blog"
	description="Guías, comparativas y recursos para empezar o cambiar de rumbo en tecnología, con etiqueta de madurez y fecha de revisión."
	noindex={!BLOG_ABIERTO}
>
	<div class="contenedor pagina">
		<h1>Blog</h1>
		{
			grupos.length > 0 ? (
				grupos.map((g) => (
					<section class="grupo" aria-labelledby={`g-${g.id}`}>
						<div class="grupo-cab">
							<h2 id={`g-${g.id}`}>{g.nombre}</h2>
							<p>{g.descripcion}</p>
						</div>
						<ul class="lista">
							{g.posts.map((post) => (
								<li>
									<a class="item" href={`/blog/${post.id}/`}>
										<span class="item-titulo">{post.data.title}</span>
										<span class="item-desc">{post.data.description}</span>
									</a>
									<span class="item-meta">
										<EtiquetaMadurez madurez={post.data.madurez} />
										<FormattedDate date={post.data.revisado} />
									</span>
								</li>
							))}
						</ul>
					</section>
				))
			) : (
				<div class="lectura vacio">
					<p class="entradilla">El jardín se está plantando.</p>
					<p>
						Todavía no he publicado guías. Primero estoy compartiendo en redes y preparando los primeros artículos, que
						abriré cuando tenga la constancia y los temas claros.
					</p>
					<p>
						<a class="boton" href="/sobre-mi/">Cómo trabajo</a>
					</p>
				</div>
			)
		}
	</div>
</Base>

<style>
	.pagina {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
	}
	.entradilla {
		font-size: 1.25rem;
	}
	.grupo {
		margin-top: 3rem;
	}
	.grupo-cab p {
		margin: 0;
	}
	.lista {
		margin: 1.2rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 2px solid var(--verde-bosque);
	}
	.lista li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
		padding-block: 1.1rem;
		border-bottom: 2px solid var(--verde-bosque);
	}
	.item {
		flex: 1 1 22rem;
		text-decoration: none;
	}
	.item-titulo {
		display: block;
		font-family: var(--fuente-titulos);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: underline;
		text-decoration-color: var(--lila);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}
	.item-desc {
		display: block;
		margin-top: 0.3rem;
	}
	.item-meta {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9rem;
	}
</style>
